<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_befriend-pres._tcp</string>
		<string>_befriend-pres._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>befriend uses the camera for the features you turn on: a timelapse of your focus sessions, and a posture check. Videos and camera images stay on this Mac.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>befriend turns speech in the audio and video you add to Chat into text, on this device, so your friend can answer questions about it.</string>
	<key>StaticAPIKey</key>
	<string>$(STATIC_API_KEY)</string>
</dict>
</plist>
