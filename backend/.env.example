# Copy to .env for local development (gitignored). docker-compose's api service also reads it
# and overrides the hostnames to the compose service names.

# ======================= SYSTEM =======================
SYSTEM_SERVER=127.0.0.1
# 8305, not 7000: macOS AirPlay Receiver (Control Center) listens on 7000.
SYSTEM_ADDR=:8305
# debug, release, test
SYSTEM_MODE=debug
SYSTEM_TIME_ZONE=Asia/Jakarta
# Header holding the real client IP behind a proxy. Prefer one the proxy OVERWRITES (CF-Connecting-IP):
# X-Forwarded-For is appended to, so its first hop can still be client-supplied.
# The header is only honoured for requests from SYSTEM_TRUSTED_PROXIES (comma-separated IPs/CIDRs,
# e.g. 127.0.0.1 for a local cloudflared); with no trusted proxies it is ignored.
SYSTEM_PROXY_HEADER=
SYSTEM_TRUSTED_PROXIES=

# ======================= ABUSE LIMITS =======================
# Requests per minute per client IP, per auth route (register, verify-email, resend-code, login, refresh).
AUTH_RATE_LIMIT_PER_MINUTE=10
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ======================= DATABASE (docker compose postgres) =======================
DB_USERNAME=befriend
DB_PASSWORD=befriend
DB_NAME=befriend
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_DEBUG=true

# ======================= SMTP (Mailpit: no auth, inbox at http://localhost:8025) =======================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=befriend@localhost

# ======================= STATIC API KEY =======================
# Sent by the apps in the STATIC-API-KEY header. It ships inside the apps, so it filters noise; it is not a secret.
STATIC_API_KEY=change-me

# ======================= SIGN IN WITH APPLE =======================
# Accepted identity-token audiences (the app's bundle ID; comma-separated). Empty = Apple sign-in disabled.
APPLE_BUNDLE_IDS=com.richardsonjp.befriend
# Optional server credentials (Certificates, Identifiers & Profiles > Keys, "Sign in with Apple" enabled).
# Needed to exchange codes for Apple refresh tokens, which account deletion uses to revoke Apple access.
# APPLE_PRIVATE_KEY is the .p8 file contents on one line with literal \n between lines.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ======================= GOOGLE SIGN-IN =======================
# Accepted ID-token audiences: the iOS and macOS OAuth client IDs (comma-separated). Empty = disabled.
GOOGLE_CLIENT_IDS=

# ======================= PERSONALITY GENERATION (OpenRouter) =======================
# Without a key, friends are created but their personality stays "pending" until one is set.
# Allow free endpoints in your OpenRouter privacy settings; free providers may log prompts.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Request budget kept under OpenRouter's free limits (raise after buying credits).
LLM_MINUTE_CAP=16
LLM_DAILY_CAP=45
LLM_WORKER_INTERVAL_SECONDS=10
LLM_WORKER_BATCH_SIZE=2
# Weekly evolutions leave this many of the daily requests for onboarding.
LLM_ONBOARDING_RESERVE=10

# ======================= APNs (Live Activity + widget pushes) =======================
# A key from Certificates, Identifiers & Profiles > Keys with "Apple Push Notifications service" enabled.
# APNS_PRIVATE_KEY is the .p8 contents on one line with literal \n between lines. Empty = no pushes.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.richardsonjp.befriend
PRESENCE_SWEEP_INTERVAL_SECONDS=30

# ======================= PASETO (required; generate each with: openssl rand -hex 32) =======================
PASETO_ACCESS_SECRET=
PASETO_REFRESH_SECRET=
PASETO_ACCESS_EXPIRY_MINUTES=15
PASETO_REFRESH_EXPIRY_DAYS=7
